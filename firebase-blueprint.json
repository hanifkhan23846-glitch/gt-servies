    "Admin": {
      "title": "Admin",
      "description": "Authorized Super Admin account record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the admin" },
        "email": { "type": "string", "description": "Verified Google email address" },
        "adminKey": { "type": "string", "description": "Optional verification credential for admin session activation" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "email", "createdAt"]
    },
