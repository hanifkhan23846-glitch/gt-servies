        "adminKeyHash": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["loginEmail", "adminKeyHash", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
