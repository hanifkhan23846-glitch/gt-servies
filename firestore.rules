                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /medicalProducts/{productId} {
      allow get: if isSignedIn() && isValidId(productId) &&
                    (existing().isAvailable == true || existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (existing().isAvailable == true || existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(productId) &&
                       isValidGroceryProduct(incoming()) &&
                       incoming().keys().hasAll(['storeId', 'storeName', 'ownerId', 'categoryId', 'categoryName', 'name', 'description', 'regularPricePkr', 'discountPricePkr', 'unit', 'stockQuantity', 'isAvailable', 'isFeatured', 'city', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['storeId', 'storeName', 'ownerId', 'categoryId', 'categoryName', 'name', 'description', 'regularPricePkr', 'discountPricePkr', 'unit', 'stockQuantity', 'imageUrl', 'additionalImages', 'isAvailable', 'isFeatured', 'city', 'createdAt', 'updatedAt']) &&
                       exists(/databases/$(database)/documents/medicalStores/$(incoming().storeId)) &&
                       (
                         isAdmin() ||
                         (
                           incoming().ownerId == request.auth.uid &&
                           get(/databases/$(database)/documents/medicalStores/$(incoming().storeId)).data.ownerId == request.auth.uid
                         )
                       );
      allow update: if isSignedIn() && isValidId(productId) &&
                       isValidGroceryProduct(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           existing().ownerId == request.auth.uid &&
                           incoming().storeId == existing().storeId &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['categoryId', 'categoryName', 'name', 'description', 'regularPricePkr', 'discountPricePkr', 'unit', 'stockQuantity', 'imageUrl', 'additionalImages', 'isAvailable', 'isFeatured', 'updatedAt'])
                         )
                       );
      allow delete: if isSignedIn() && isValidId(productId) && (isAdmin() || existing().ownerId == request.auth.uid);
    }

    match /parcelRiderRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) &&
                    (
                      existing().requesterId == request.auth.uid ||
                      existing().riderId == request.auth.uid ||
                      existing().restaurantId in staffRestaurantIds() ||
                      existing().approvalStatus == 'approved' ||
                      isAdmin()
                    );
      allow list: if isSignedIn() &&
                     (
                       existing().requesterId == request.auth.uid ||
                       existing().riderId == request.auth.uid ||
                       existing().restaurantId in staffRestaurantIds() ||
                       existing().approvalStatus == 'approved' ||
                       isAdmin()
                     );
      allow create: if isSignedIn() && isValidId(requestId) &&
                       isValidParcelRiderRequest(incoming()) &&
                       incoming().requesterId == request.auth.uid &&
                       incoming().approvalStatus == 'pending' &&
                       incoming().riderId == '' &&
                       incoming().riderName == '' &&
                       incoming().adminNote == '' &&
                       (
                         incoming().restaurantId == 'customer_direct' ||
                         (
                           exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) &&
                           (
                             get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid ||
                             incoming().restaurantId in staffRestaurantIds()
                           )
                         )
                       ) &&
                       incoming().keys().hasAll(['requestType', 'requesterId', 'restaurantId', 'restaurantName', 'pickupAddress', 'dropoffAddress', 'city', 'recipientName', 'recipientPhone', 'details', 'offeredFeePkr', 'approvalStatus', 'riderId', 'riderName', 'adminNote', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['requestType', 'requesterId', 'restaurantId', 'restaurantName', 'pickupAddress', 'dropoffAddress', 'city', 'recipientName', 'recipientPhone', 'details', 'offeredFeePkr', 'approvalStatus', 'riderId', 'riderName', 'adminNote', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() && isValidId(requestId) &&
                       isValidParcelRiderRequest(incoming()) &&
                       incoming().requestType == existing().requestType &&
                       incoming().requesterId == existing().requesterId &&
                       incoming().restaurantId == existing().restaurantId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           !(existing().approvalStatus in ['rejected', 'completed']) &&
                           (
                             (
                               existing().approvalStatus == 'approved' &&
                               existing().riderId == '' &&
                               incoming().riderId == request.auth.uid &&
                               incoming().approvalStatus == 'rider_assigned' &&
                               exists(/databases/$(database)/documents/riders/$(request.auth.uid)) &&
                               get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.approvalStatus == 'approved' &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['riderId', 'riderName', 'approvalStatus', 'updatedAt'])
                             ) ||
                             (
                               existing().riderId == request.auth.uid &&
                               existing().approvalStatus in ['rider_assigned', 'picked_up'] &&
                               incoming().approvalStatus in ['picked_up', 'completed'] &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['approvalStatus', 'updatedAt'])
                             )
                           )
                         )
                       );
      allow delete: if isAdmin() && isValidId(requestId);
    }

    match /riders/{riderId} {
      allow get: if isSignedIn() && isValidId(riderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(riderId) &&
                       riderId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       incoming().approvalStatus == 'pending' &&
                       incoming().totalEarningsPkr == 0 &&
                       incoming().completedDeliveries == 0 &&
                       incoming().keys().hasAll(['userId', 'fullName', 'phone', 'email', 'cnicNumber', 'licenseNumber', 'vehicleType', 'vehicleNumber', 'city', 'approvalStatus', 'isOnline', 'latitude', 'longitude', 'totalEarningsPkr', 'completedDeliveries', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'fullName', 'phone', 'email', 'cnicNumber', 'licenseNumber', 'vehicleType', 'vehicleNumber', 'city', 'approvalStatus', 'isOnline', 'latitude', 'longitude', 'totalEarningsPkr', 'completedDeliveries', 'createdAt', 'updatedAt']) &&
                       isValidRider(incoming());
      allow update: if isSignedIn() && isValidId(riderId) &&
                       isValidRider(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'latitude', 'longitude', 'phone', 'vehicleType', 'vehicleNumber', 'city', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() && isValidId(riderId);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) &&
                    (
                      existing().customerId == request.auth.uid ||
                      existing().vendorOwnerId == request.auth.uid ||
                      (existing().orderType == 'food' && existing().vendorId in staffRestaurantIds()) ||
                      existing().riderId == request.auth.uid ||
                      (existing().status == 'Ready for Pickup' && existing().riderId == '') ||
                      isAdmin()
                    );
      allow list: if isSignedIn() &&
                     (
                       existing().customerId == request.auth.uid ||
                       existing().vendorOwnerId == request.auth.uid ||
                       existing().vendorId in staffRestaurantIds() ||
                       existing().riderId == request.auth.uid ||
                       (existing().status == 'Ready for Pickup' && existing().riderId == '') ||
                       isAdmin()
                     );
      allow create: if isSignedIn() && isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().customerId == request.auth.uid &&
                       incoming().riderId == '' &&
                       incoming().status == 'Pending' &&
                       incoming().keys().hasAll(['orderType', 'customerId', 'customerName', 'customerPhone', 'vendorId', 'vendorName', 'vendorOwnerId', 'riderId', 'riderName', 'deliveryAddress', 'city', 'deliveryLat', 'deliveryLng', 'items', 'subtotalPkr', 'deliveryFeePkr', 'discountPkr', 'couponCode', 'totalPkr', 'commissionPkr', 'vendorEarningsPkr', 'riderEarningsPkr', 'paymentMethod', 'paymentStatus', 'status', 'cancellationReason', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['orderType', 'customerId', 'customerName', 'customerPhone', 'vendorId', 'vendorName', 'vendorOwnerId', 'riderId', 'riderName', 'deliveryAddress', 'city', 'deliveryLat', 'deliveryLng', 'items', 'subtotalPkr', 'deliveryFeePkr', 'discountPkr', 'couponCode', 'totalPkr', 'commissionPkr', 'vendorEarningsPkr', 'riderEarningsPkr', 'paymentMethod', 'paymentStatus', 'status', 'cancellationReason', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() && isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().customerId == existing().customerId &&
                       incoming().vendorId == existing().vendorId &&
                       incoming().vendorOwnerId == existing().vendorOwnerId &&
                       incoming().orderType == existing().orderType &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           !(existing().status in ['Delivered', 'Cancelled', 'Rejected']) &&
                           (
                             // Action 1: Customer cancels Pending or Accepted order
                             (
                               existing().customerId == request.auth.uid &&
                               existing().status in ['Pending', 'Accepted'] &&
                               incoming().status == 'Cancelled' &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt'])
                             ) ||
                             // Action 2: Vendor accepts, rejects, prepares, or marks Ready for Pickup
                             (
                               (
                                 existing().vendorOwnerId == request.auth.uid ||
                                 (existing().orderType == 'food' && existing().vendorId in staffRestaurantIds())
                               ) &&
                               incoming().status in ['Accepted', 'Rejected', 'Preparing', 'Ready for Pickup'] &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt'])
                             ) ||
                             // Action 3: Approved rider claims Ready for Pickup order
                             (
                               existing().status == 'Ready for Pickup' &&
                               existing().riderId == '' &&
                               incoming().riderId == request.auth.uid &&
                               incoming().status == 'Rider Assigned' &&
                               exists(/databases/$(database)/documents/riders/$(request.auth.uid)) &&
                               get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.approvalStatus == 'approved' &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['riderId', 'riderName', 'status', 'updatedAt'])
                             ) ||
                             // Action 4: Assigned rider advances pickup and delivery
                             (
                               existing().riderId == request.auth.uid &&
                               incoming().status in ['Picked Up', 'On the Way', 'Delivered'] &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])
                             )
                           )
                         )
                       );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get: if isSignedIn() && isValidId(reviewId) && (existing().isHidden == false || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().isHidden == false || existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(reviewId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().isHidden == false &&
                       incoming().keys().hasAll(['userId', 'userName', 'orderId', 'targetId', 'targetType', 'targetName', 'rating', 'comment', 'isHidden', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'userName', 'orderId', 'targetId', 'targetType', 'targetName', 'rating', 'comment', 'isHidden', 'createdAt', 'updatedAt']) &&
                       isValidReview(incoming());
      allow update: if isSignedIn() && isValidId(reviewId) &&
                       isValidReview(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(reviewId) && (isAdmin() || existing().userId == request.auth.uid);
    }

    match /coupons/{couponId} {
      allow get: if isSignedIn() && isValidId(couponId) && (existing().isActive == true || isAdmin());
      allow list: if isSignedIn() && (existing().isActive == true || isAdmin());
      allow create: if isAdmin() && isValidId(couponId) &&
                       incoming().keys().hasAll(['code', 'discountType', 'discountValue', 'minOrderPkr', 'maxDiscountPkr', 'usageLimit', 'usedCount', 'isActive', 'expiresAtEpochMs', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['code', 'discountType', 'discountValue', 'minOrderPkr', 'maxDiscountPkr', 'usageLimit', 'usedCount', 'isActive', 'expiresAtEpochMs', 'createdAt', 'updatedAt']) &&
                       isValidCoupon(incoming());
      allow update: if isAdmin() && isValidId(couponId) &&
                       isValidCoupon(incoming()) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(couponId);
    }

    match /platformSettings/{settingId} {
      allow get: if isSignedIn() && settingId == 'global';
      allow list: if isAdmin();
      allow create, update: if isAdmin() && settingId == 'global' &&
                               incoming().keys().hasAll(['cities', 'restaurantCommissionPercent', 'groceryCommissionPercent', 'baseDeliveryFeePkr', 'riderPayoutPkr', 'jazzCashConfigured', 'easypaisaConfigured', 'updatedAt']) &&
                               incoming().keys().hasOnly(['cities', 'restaurantCommissionPercent', 'groceryCommissionPercent', 'baseDeliveryFeePkr', 'riderPayoutPkr', 'jazzCashConfigured', 'easypaisaConfigured', 'jazzCashNumber', 'jazzCashAccountTitle', 'easypaisaNumber', 'easypaisaAccountTitle', 'beneficiaryAccounts', 'promoBannerEnabled', 'promoCode', 'promoDiscountPercent', 'promoBadgeText', 'promoTitle', 'promoSubtitle', 'promoRestaurantId', 'promoRestaurantName', 'promoOffers', 'deliveryAreaFeeRules', 'multanCityDeliveryFees', 'multanDefaultDeliveryFeePkr', 'radiusPricingEnabled', 'deliveryBaseRadiusKm', 'withinRadiusFeePkr', 'extraPerKmFeePkr', 'supportPhoneLocal', 'supportWhatsappNumber', 'updatedAt']) &&
                               isValidPlatformSettings(incoming());
      allow delete: if false;
    }

    match /cityRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (existing().requesterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().requesterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(requestId) &&
                       incoming().requesterId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().cityName is string && incoming().cityName.size() >= 2 && incoming().cityName.size() <= 60 &&
                       incoming().requesterName is string && incoming().requesterName.size() <= 80 &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().keys().hasAll(['cityName', 'requesterId', 'requesterName', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['cityName', 'requesterId', 'requesterName', 'status', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() && isValidId(requestId) &&
                       incoming().status in ['pending', 'approved', 'rejected'] &&
                       incoming().requesterId == existing().requesterId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt);
      allow delete: if isAdmin() && isValidId(requestId);
    }

    match /adminActivityLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) &&
                       incoming().adminId == request.auth.uid &&
                       incoming().keys().hasAll(['adminId', 'adminEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt']) &&
                       incoming().keys().hasOnly(['adminId', 'adminEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt']) &&
                       isValidAdminLog(incoming());
      allow update, delete: if false;
    }

    match /supportChats/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin()) &&
                       incoming().keys().hasAll(['userId', 'customerName', 'customerPhone', 'supportPhone', 'lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByCustomer', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'customerName', 'customerPhone', 'supportPhone', 'lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByCustomer', 'createdAt', 'updatedAt']) &&
                       isValidSupportChatThread(incoming(), userId);
      allow update: if isSignedIn() && isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin()) &&
                       incoming().keys().hasAll(['userId', 'customerName', 'customerPhone', 'supportPhone', 'lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByCustomer', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'customerName', 'customerPhone', 'supportPhone', 'lastMessage', 'lastSenderRole', 'unreadByAdmin', 'unreadByCustomer', 'createdAt', 'updatedAt']) &&
                       isValidSupportChatThread(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(userId);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(messageId) && (request.auth.uid == userId || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && isValidId(userId) && isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'senderId', 'senderName', 'senderRole', 'text', 'orderId', 'supportPhone', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'senderId', 'senderName', 'senderRole', 'text', 'orderId', 'supportPhone', 'imageUrl', 'audioBase64', 'audioDurationSec', 'createdAt']) &&
                         isValidSupportChatMessage(incoming(), userId) &&
                         incoming().senderId == request.auth.uid &&
                         (
                           (request.auth.uid == userId && incoming().senderRole == 'customer') ||
                           (isAdmin() && incoming().senderRole == 'admin')
                         );
        allow update, delete: if false;
      }
    }
  }
}
